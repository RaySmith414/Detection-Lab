// Certutil Used to Download a File
// Sigma rule: rules/sigma/windows/win_certutil_download.yml (d01d9d84-17e6-46e7-89c8-b3fd295aea33)
// Level: high. ATT&CK: T1105 Ingress Tool Transfer
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and ((process.executable:"*\\certutil.exe" or process.pe.original_file_name:"CertUtil.exe") and (process.command_line like~ ("*urlcache*", "*verifyctl*")) and process.command_line:"*http*")
