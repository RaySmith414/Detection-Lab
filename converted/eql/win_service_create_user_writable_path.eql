// Service Created From a User-Writable Path
// Sigma rule: rules/sigma/windows/win_service_create_user_writable_path.yml (9d18fbf3-dcfb-462b-b786-0b9f5f2f99bd)
// Level: high. ATT&CK: T1543.003 Windows Service
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and (process.executable:"*\\sc.exe" and (process.command_line:"*create*" and process.command_line:"*binPath*") and (process.command_line like~ ("*\\AppData\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*\\Temp\\*", "*cmd /c*", "*cmd.exe /c*", "*powershell*")))
