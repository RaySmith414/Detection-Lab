// Service Installed From a User-Writable Path
// Sigma rule: rules/sigma/windows/win_service_installed_suspicious_path.yml (b28c44d8-1bb2-4e44-973d-42281a6c939f)
// Level: high. ATT&CK: T1543.003 Windows Service
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where winlog.channel:"System" and (event.code:"7045" and (winlog.event_data.ImagePath like~ ("*\\ProgramData\\*", "*\\AppData\\*", "*\\Users\\Public\\*", "*\\Temp\\*", "*powershell*", "*cmd.exe /c*", "*%COMSPEC%*")))
