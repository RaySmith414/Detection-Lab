// Office Application Started a Script Host or Shell
// Sigma rule: rules/sigma/windows/win_office_spawns_script_host.yml (27adea6d-7170-4677-a160-8d71eb9061a8)
// Level: high. ATT&CK: T1566.001 Spearphishing Attachment, T1204.002 Malicious File
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and ((process.parent.executable like~ ("*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe", "*\\outlook.exe", "*\\mspub.exe", "*\\msaccess.exe")) and (process.executable like~ ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\rundll32.exe", "*\\regsvr32.exe")))
