// Script or Shortcut Written to a Startup Folder
// Sigma rule: rules/sigma/windows/win_startup_folder_script_drop.yml (f166951d-b2ce-4b52-9481-cbcf40f63ee1)
// Level: medium. ATT&CK: T1547.001 Registry Run Keys / Startup Folder
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"11") and (file.path:"*\\Start Menu\\Programs\\Startup\\*" and (file.path like~ ("*.lnk", "*.vbs", "*.js", "*.bat", "*.cmd", "*.ps1", "*.hta", "*.exe")) and (process.executable like~ ("*\\powershell.exe", "*\\pwsh.exe", "*\\cmd.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\rundll32.exe")))
