// Scheduled Task Registered With a Suspicious Command
// Sigma rule: rules/sigma/windows/win_scheduled_task_created_suspicious_command.yml (2e6b0b82-fe1c-447c-b6ce-8ce57a35a1f2)
// Level: high. ATT&CK: T1053.005 Scheduled Task
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where winlog.channel:"Security" and (event.code:"4698" and (winlog.event_data.TaskContent like~ ("*\\ProgramData\\*", "*\\AppData\\*", "*\\Users\\Public\\*", "*\\Temp\\*", "*powershell*", "*mshta*", "*wscript*", "*cscript*", "*rundll32*")))
