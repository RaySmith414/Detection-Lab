// System Process Name Running From an Unusual Path
// Sigma rule: rules/sigma/windows/win_masquerading_system_binary_wrong_path.yml (ab550a69-7120-41cb-98e9-82afa22a10d9)
// Level: high. ATT&CK: T1036.005 Match Legitimate Resource Name or Location
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and ((process.executable like~ ("*\\svchost.exe", "*\\lsass.exe", "*\\csrss.exe", "*\\services.exe", "*\\winlogon.exe", "*\\smss.exe", "*\\spoolsv.exe", "*\\taskhostw.exe")) and (not (process.executable like~ ("C:\\Windows\\System32\\*", "C:\\Windows\\SysWOW64\\*", "C:\\Windows\\WinSxS\\*"))))
