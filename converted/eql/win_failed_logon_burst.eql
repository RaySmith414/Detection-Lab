// Burst of Failed Logons From One Source Address
// Sigma rule: rules/sigma/windows/win_failed_logon_burst.yml (0c6c3a57-7f0b-4b63-8c1b-9a3e5d7f1b24)
// Level: high. ATT&CK: T1110 Brute Force
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
// Search with "tiebreaker_field": "event.id". Elasticsearch does not chain events that
// share a timestamp without one and would miss a burst that arrives within one second.
sequence by winlog.event_data.IpAddress with maxspan=5m 
 [any where winlog.channel:"Security" and event.code:"4625"]  with runs=10
