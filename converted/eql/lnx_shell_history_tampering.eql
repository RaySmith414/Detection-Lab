// Shell History Cleared or Disabled
// Sigma rule: rules/sigma/linux/lnx_shell_history_tampering.yml (f32b64f3-4786-44cb-9198-f4aac67996d3)
// Level: medium. ATT&CK: T1070.003 Clear Command History, T1690 Prevent Command History Logging
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (host.os.type:"linux" and event.category:"process" and event.type:"start") and ((process.command_line like~ ("*history -c*", "*unset HISTFILE*", "*HISTFILE=/dev/null*", "*HISTSIZE=0*")) or (process.command_line:"*.bash_history*" and (process.command_line like~ ("*rm *", "*shred *", "*truncate *", "*/dev/null*"))))
