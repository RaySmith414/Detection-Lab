// Regsvr32 Scriptlet Execution
// Sigma rule: rules/sigma/windows/win_regsvr32_scriptlet.yml (43fdb8e6-1895-44a1-a45c-17d5b12aa49b)
// Level: high. ATT&CK: T1218.010 Regsvr32
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and (process.executable:"*\\regsvr32.exe" and process.command_line:"*scrobj.dll*" and (process.command_line like~ ("*/i:*", "*-i:*")))
