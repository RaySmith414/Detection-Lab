// Sudoers File Changed From the Command Line
// Sigma rule: rules/sigma/linux/lnx_sudoers_modification.yml (c62978e7-b5b3-4fc7-8d92-741fa7a854a6)
// Level: high. ATT&CK: T1548.003 Sudo and Sudo Caching
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (host.os.type:"linux" and event.category:"process" and event.type:"start") and (process.command_line:"*/etc/sudoers*" and (process.command_line like~ ("*>>*", "*> /*", "*tee *", "*sed -i*")))
