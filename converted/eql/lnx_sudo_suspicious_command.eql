// Sudo Running a Root Shell or Touching Credential Files
// Sigma rule: rules/sigma/linux/lnx_sudo_suspicious_command.yml (7c1e5a2b-9d3f-4e68-b0a4-5f6e7d8c9b1a)
// Level: medium. ATT&CK: T1548.003 Sudo and Sudo Caching
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where event.dataset:"system.auth" and ((process.name:"sudo" and message:"*COMMAND=*") and (message like~ ("*COMMAND=/bin/bash*", "*COMMAND=/usr/bin/bash*", "*COMMAND=/bin/sh*", "*COMMAND=/usr/bin/sh*", "*/etc/shadow*", "*passwd root*", "*useradd -o -u 0*", "*chmod 777 /tmp/*")))
