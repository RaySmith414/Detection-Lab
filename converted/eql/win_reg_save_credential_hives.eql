// Registry Hives With Credentials Saved to Disk
// Sigma rule: rules/sigma/windows/win_reg_save_credential_hives.yml (7cfee3f8-0061-42bb-88dd-467e85b92271)
// Level: high. ATT&CK: T1003.002 Security Account Manager
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and (process.executable:"*\\reg.exe" and (process.command_line like~ ("* save *", "* export *")) and (process.command_line like~ ("*hklm\\sam*", "*hklm\\system*", "*hklm\\security*", "*HKEY_LOCAL_MACHINE\\SAM*", "*HKEY_LOCAL_MACHINE\\SYSTEM*", "*HKEY_LOCAL_MACHINE\\SECURITY*")))
