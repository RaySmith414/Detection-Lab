// Host Firewall Stopped or Flushed
// Sigma rule: rules/sigma/linux/lnx_firewall_disabled.yml (491da640-9ec4-4086-8cea-45d44589d82d)
// Level: high. ATT&CK: T1686 Disable or Modify System Firewall
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (host.os.type:"linux" and event.category:"process" and event.type:"start") and ((process.executable:"*/ufw" and process.command_line:"*disable*") or ((process.executable like~ ("*/iptables", "*/ip6tables")) and (process.command_line like~ ("* -F*", "* --flush*"))) or ((process.executable:"*/systemctl" and (process.command_line like~ ("*stop*", "*disable*", "*mask*"))) and (process.command_line like~ ("*firewalld*", "*ufw*", "*nftables*"))))
