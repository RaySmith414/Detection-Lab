// Reverse Shell One-Liner
// Sigma rule: rules/sigma/linux/lnx_reverse_shell_oneliner.yml (ef1a5fa0-fa85-4819-94a0-b6dd29e9bce2)
// Level: high. ATT&CK: T1059.004 Unix Shell
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (host.os.type:"linux" and event.category:"process" and event.type:"start") and ((process.command_line like~ ("*/dev/tcp/*", "*/dev/udp/*")) or ((process.executable like~ ("*/nc", "*/ncat", "*/netcat", "*/nc.traditional")) and (process.command_line like~ ("* -e *", "* -c *"))))
