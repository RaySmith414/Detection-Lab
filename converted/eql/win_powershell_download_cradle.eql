// PowerShell Download and Execute Cradle
// Sigma rule: rules/sigma/windows/win_powershell_download_cradle.yml (6149f647-d4e9-4543-8cfd-3a3b0fdc3a7f)
// Level: high. ATT&CK: T1059.001 PowerShell, T1105 Ingress Tool Transfer
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and (((process.executable like~ ("*\\powershell.exe", "*\\pwsh.exe")) or (process.pe.original_file_name like~ ("PowerShell.EXE", "pwsh.dll"))) and (process.command_line like~ ("*DownloadString*", "*DownloadFile*", "*DownloadData*", "*Invoke-WebRequest*", "*Net.WebClient*")) and (process.command_line like~ ("*IEX*", "*Invoke-Expression*")))
