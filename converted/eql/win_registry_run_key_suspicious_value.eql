// Run Key Pointing at a Suspicious Location
// Sigma rule: rules/sigma/windows/win_registry_run_key_suspicious_value.yml (056d2007-ee89-46fe-bcad-a99a133d33bc)
// Level: medium. ATT&CK: T1547.001 Registry Run Keys / Startup Folder
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"13") and (registry.path:"*\\CurrentVersion\\Run*" and (registry.data.strings like~ ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\Windows\\Temp\\*", "*powershell*", "*mshta*", "*wscript*", "*cscript*", "*rundll32*", "*regsvr32*")))
