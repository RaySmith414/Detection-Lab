// Setuid Bit Placed on a Shell or a File in a Temporary Folder
// Sigma rule: rules/sigma/linux/lnx_setuid_bit_on_shell.yml (592a156a-3557-48d7-8031-8f6ff313d5e1)
// Level: high. ATT&CK: T1548.001 Setuid and Setgid
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (host.os.type:"linux" and event.category:"process" and event.type:"start") and (process.executable:"*/chmod" and (process.command_line like~ ("*u+s*", "* +s *", "* 4755 *", "* 4777 *", "* 6755 *")) and (process.command_line like~ ("*/bin/bash*", "*/bin/sh*", "*/bin/dash*", "*/bin/zsh*", "*/tmp/*", "*/dev/shm/*", "*/var/tmp/*")))
