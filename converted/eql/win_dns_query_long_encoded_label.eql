// DNS Query With a Long Encoded First Label
// Sigma rule: rules/sigma/windows/win_dns_query_long_encoded_label.yml (b5cdb5c5-e63d-4343-b6cd-c97f5e265d3b)
// Level: medium. ATT&CK: T1071.004 DNS, T1048.003 Exfiltration Over Unencrypted Non-C2 Protocol
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"22") and (dns.question.name regex~ "[0-9a-z]{16,}\\..+" and (not (dns.question.name like~ ("*.cloudfront.net", "*.akamaihd.net", "*.amazonaws.com"))))
