// Mimikatz Module Names on the Command Line
// Sigma rule: rules/sigma/windows/win_mimikatz_command_line.yml (a1646766-8b11-4c48-8b36-e4863b7cd865)
// Level: critical. ATT&CK: T1003.001 LSASS Memory
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and ((process.executable:"*\\mimikatz.exe" or process.pe.original_file_name:"mimikatz.exe") or (process.command_line like~ ("*sekurlsa::*", "*lsadump::*", "*kerberos::ptt*", "*privilege::debug*", "*token::elevate*")))
