// Cron Table Written From the Command Line
// Sigma rule: rules/sigma/linux/lnx_cron_persistence_write.yml (1d0fa417-297d-4eec-9239-6cdc21fb4b16)
// Level: medium. ATT&CK: T1053.003 Cron
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (host.os.type:"linux" and event.category:"process" and event.type:"start") and ((process.command_line like~ ("*/etc/crontab*", "*/etc/cron.d/*", "*/var/spool/cron*")) and (process.command_line like~ ("*>>*", "*> /*", "*tee *")))
