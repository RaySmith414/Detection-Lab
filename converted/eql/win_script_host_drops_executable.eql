// Script Host or Office Program Writes an Executable to a User Folder
// Sigma rule: rules/sigma/windows/win_script_host_drops_executable.yml (e7bcd3af-e758-437c-80c4-732c603bda68)
// Level: high. ATT&CK: T1105 Ingress Tool Transfer
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"11") and ((process.executable like~ ("*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\winword.exe", "*\\excel.exe", "*\\powerpnt.exe")) and (file.path like~ ("*.exe", "*.dll", "*.scr")) and (file.path like~ ("*\\AppData\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*\\Temp\\*")))
