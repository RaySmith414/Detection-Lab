// Mshta Running Remote or Inline Script
// Sigma rule: rules/sigma/windows/win_mshta_remote_payload.yml (8d74ad08-9ddc-450d-9b38-ae8b476eb13e)
// Level: high. ATT&CK: T1218.005 Mshta
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and (process.executable:"*\\mshta.exe" and (process.command_line like~ ("*http://*", "*https://*", "*javascript:*", "*vbscript:*")))
