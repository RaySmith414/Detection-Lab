// PowerShell Uploading a File Over HTTP
// Sigma rule: rules/sigma/windows/win_powershell_http_upload.yml (507c262e-1345-4142-b878-d6ca80ca3f89)
// Level: medium. ATT&CK: T1048 Exfiltration Over Alternative Protocol
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and (((process.executable like~ ("*\\powershell.exe", "*\\pwsh.exe")) or (process.pe.original_file_name like~ ("PowerShell.EXE", "pwsh.dll"))) and (process.command_line like~ ("*Invoke-WebRequest*", "*Invoke-RestMethod*", "*iwr *", "*irm *")) and (process.command_line like~ ("*-Method POST*", "*-Method PUT*")) and process.command_line:"*-InFile*")
