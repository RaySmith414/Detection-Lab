// Local Account Created or Added to Administrators
// Sigma rule: rules/sigma/windows/win_local_account_or_admin_added.yml (4be6a3bb-94a2-447e-a362-bcc7fe72b063)
// Level: medium. ATT&CK: T1136.001 Local Account, T1098 Account Manipulation
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and ((process.executable like~ ("*\\net.exe", "*\\net1.exe")) and ((process.command_line:"* user *" and process.command_line:"*/add*") or (process.command_line:"*localgroup*" and process.command_line:"*administrators*" and process.command_line:"*/add*")))
