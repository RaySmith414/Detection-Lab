// Password Hash File Read With a Text Tool
// Sigma rule: rules/sigma/linux/lnx_shadow_file_read.yml (7438bbbb-34c2-4127-a9d1-1484db00913b)
// Level: medium. ATT&CK: T1003.008 /etc/passwd and /etc/shadow
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (host.os.type:"linux" and event.category:"process" and event.type:"start") and (process.command_line:"*/etc/shadow*" and (process.executable like~ ("*/cat", "*/less", "*/more", "*/head", "*/tail", "*/cp", "*/base64", "*/xxd", "*/strings")))
