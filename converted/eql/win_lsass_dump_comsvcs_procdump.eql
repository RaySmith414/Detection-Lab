// LSASS Memory Dump With Comsvcs or ProcDump
// Sigma rule: rules/sigma/windows/win_lsass_dump_comsvcs_procdump.yml (42917b2b-15a6-4bda-8d82-f09749920fcf)
// Level: critical. ATT&CK: T1003.001 LSASS Memory
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and ((process.executable:"*\\rundll32.exe" and (process.command_line:"*comsvcs*" and process.command_line:"*MiniDump*")) or ((process.executable like~ ("*\\procdump.exe", "*\\procdump64.exe")) and process.command_line:"*lsass*"))
