// Burst of Failed SSH Password Logins From One Source Address
// Sigma rule: rules/sigma/linux/lnx_ssh_failed_login_burst.yml (9b8a7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d)
// Level: high. ATT&CK: T1110.001 Password Guessing
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
// Search with "tiebreaker_field": "event.id". Elasticsearch does not chain events that
// share a timestamp without one and would miss a burst that arrives within one second.
sequence by source.ip with maxspan=5m 
 [any where event.dataset:"system.auth" and (process.name:"sshd" and message:"*Failed password for*")]  with runs=10
