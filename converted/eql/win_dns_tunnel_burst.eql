// Burst of DNS Queries With Long Encoded Labels From One Host
// Sigma rule: rules/sigma/windows/win_dns_tunnel_burst.yml (2f7d9b3a-6c4e-4d18-a5f2-7b8c9d0e1f23)
// Level: high. ATT&CK: T1071.004 DNS, T1048.003 Exfiltration Over Unencrypted Non-C2 Protocol
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
// Search with "tiebreaker_field": "event.id". Elasticsearch does not chain events that
// share a timestamp without one and would miss a burst that arrives within one second.
sequence by host.name with maxspan=5m 
 [any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"22") and (dns.question.name regex~ "[0-9a-z]{16,}\\..+" and (not (dns.question.name like~ ("*.cloudfront.net", "*.akamaihd.net", "*.amazonaws.com"))))]  with runs=10
