// Run Key Added With reg.exe
// Sigma rule: rules/sigma/windows/win_reg_add_run_key.yml (f46f211d-8912-4fff-b4b1-e5a3b8c22ef1)
// Level: medium. ATT&CK: T1547.001 Registry Run Keys / Startup Folder
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and ((process.executable:"*\\reg.exe" or process.pe.original_file_name:"reg.exe") and (process.command_line:"* add *" and process.command_line:"*\\CurrentVersion\\Run*"))
