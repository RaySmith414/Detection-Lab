// Account Created or Changed to UID 0
// Sigma rule: rules/sigma/linux/lnx_uid_zero_account_created.yml (6438817b-5aba-4fb7-9846-80029b570dc3)
// Level: critical. ATT&CK: T1136.001 Local Account, T1098 Account Manipulation
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (host.os.type:"linux" and event.category:"process" and event.type:"start") and ((process.executable like~ ("*/useradd", "*/adduser", "*/usermod")) and (process.command_line like~ ("* -u 0 *", "* -ou 0 *", "* --uid 0 *", "* --uid=0 *")))
