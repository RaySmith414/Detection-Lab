// Download Piped Straight Into a Shell
// Sigma rule: rules/sigma/linux/lnx_download_piped_to_shell.yml (b9b7c430-bb3e-44d7-a83c-a9fa10d883cd)
// Level: medium. ATT&CK: T1059.004 Unix Shell, T1105 Ingress Tool Transfer
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (host.os.type:"linux" and event.category:"process" and event.type:"start") and ((process.command_line like~ ("*curl *", "*wget *")) and ((process.command_line like~ ("*| sh", "*|sh", "*| bash", "*|bash")) or (process.command_line like~ ("*| sh *", "*|sh *", "*| bash *", "*|bash *", "*| sudo sh*", "*| sudo bash*"))))
