// Script Host or User Folder Binary Connecting to an External Address
// Sigma rule: rules/sigma/windows/win_suspicious_process_outbound_connection.yml (fc1eaf01-b8e6-4fba-8e0d-2f1531a8db2d)
// Level: medium. ATT&CK: T1071.001 Web Protocols
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"3") and (((process.executable like~ ("*\\powershell.exe", "*\\pwsh.exe", "*\\mshta.exe", "*\\wscript.exe", "*\\cscript.exe", "*\\regsvr32.exe", "*\\rundll32.exe", "*\\certutil.exe")) or (process.executable like~ ("*\\AppData\\Local\\Temp\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*\\Downloads\\*"))) and (not (destination.ip like~ ("10.*", "192.168.*", "172.16.*", "172.17.*", "172.18.*", "172.19.*", "172.20.*", "172.21.*", "172.22.*", "172.23.*", "172.24.*", "172.25.*", "172.26.*", "172.27.*", "172.28.*", "172.29.*", "172.30.*", "172.31.*", "127.*", "169.254.*"))))
