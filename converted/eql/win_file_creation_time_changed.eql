// File Creation Time Changed by a Program Outside the System Folders
// Sigma rule: rules/sigma/windows/win_file_creation_time_changed.yml (5840b228-3eb8-474a-ad3f-813bc312f94b)
// Level: medium. ATT&CK: T1070.006 Timestomp
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"2") and (process.executable:"*\\*" and (not (process.executable like~ ("C:\\Windows\\*", "C:\\Program Files\\*", "C:\\Program Files (x86)\\*"))))
