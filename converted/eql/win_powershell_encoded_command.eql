// PowerShell Started With an Encoded Command
// Sigma rule: rules/sigma/windows/win_powershell_encoded_command.yml (0a6f2b1c-5d3e-4f7a-9b8c-1d2e3f4a5b6c)
// Level: medium. ATT&CK: T1059.001 PowerShell, T1027.010 Command Obfuscation
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and ((((process.executable like~ ("*\\powershell.exe", "*\\pwsh.exe")) or (process.pe.original_file_name like~ ("PowerShell.EXE", "pwsh.dll"))) and (process.command_line like~ ("* -enc *", "* -enco*", "* -ec *", "* -EncodedCommand *"))) and (not process.parent.executable:"*\\CCM\\CcmExec.exe"))
