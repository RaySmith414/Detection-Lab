// Remote Process Creation With WMIC
// Sigma rule: rules/sigma/windows/win_wmic_remote_process_create.yml (ad89e62f-ecc1-40e6-9ac4-4a20bc0f61d4)
// Level: high. ATT&CK: T1047 Windows Management Instrumentation
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and (process.executable:"*\\wmic.exe" and (process.command_line:"*/node:*" and process.command_line:"*process*" and process.command_line:"*call*" and process.command_line:"*create*"))
