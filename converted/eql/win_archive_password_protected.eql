// Password Protected Archive Created With 7-Zip or WinRAR
// Sigma rule: rules/sigma/windows/win_archive_password_protected.yml (f5dd1d0e-abd1-4143-905b-608f0e8aefc9)
// Level: medium. ATT&CK: T1560.001 Archive via Utility
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and (((process.executable like~ ("*\\7z.exe", "*\\7za.exe", "*\\7zr.exe")) and (process.command_line:"* a *" and process.command_line:"* -p*")) or ((process.executable like~ ("*\\rar.exe", "*\\winrar.exe")) and (process.command_line:"* a *" and process.command_line:"* -hp*")))
