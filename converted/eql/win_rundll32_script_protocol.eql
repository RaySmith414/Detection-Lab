// Rundll32 Running Script Through a Protocol Handler
// Sigma rule: rules/sigma/windows/win_rundll32_script_protocol.yml (04218178-9c68-4b4f-a5ad-fb71d2ae442a)
// Level: high. ATT&CK: T1218.011 Rundll32
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where (event.provider:"Microsoft-Windows-Sysmon" and event.code:"1") and (process.executable:"*\\rundll32.exe" and (process.command_line like~ ("*javascript:*", "*vbscript:*", "*RunHTMLApplication*")))
