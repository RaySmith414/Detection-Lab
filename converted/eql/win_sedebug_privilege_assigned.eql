// SeDebugPrivilege Assigned to a User Logon
// Sigma rule: rules/sigma/windows/win_sedebug_privilege_assigned.yml (f47c1797-73bc-461d-a82a-0b4743f224f2)
// Level: low. ATT&CK: T1134 Access Token Manipulation
// Generated by `python -m detlab build`. Change the Sigma rule, not this file.
any where winlog.channel:"Security" and ((event.code:"4672" and winlog.event_data.PrivilegeList:"*SeDebugPrivilege*") and (not ((winlog.event_data.SubjectUserName like~ ("SYSTEM", "LOCAL SERVICE", "NETWORK SERVICE")) or winlog.event_data.SubjectUserName:"*$")))
